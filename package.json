{
  "name": "column-extension-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable TypeScript browser-extension project template",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm --filter core build && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
