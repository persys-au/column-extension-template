# Local template. Server runtime values and browser build-time values are parsed separately.

NODE_ENV=development
PORT=3000

# Optional server-side AI provider configuration. Leave AI_PROVIDER empty until a product wires an
# analysis service into its API. Supported built-in providers are openai and anthropic.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=4096

# Provider-specific values take precedence over the generic AI_MODEL and AI_API_KEY values.
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

# Optional extension-to-server API endpoint for a product that adds a server.
VITE_API_BASE_URL=http://localhost:3000

# Public Flagsmith environment key used by the extension. Never use an admin key here.
VITE_FLAGSMITH_ENV_KEY=
