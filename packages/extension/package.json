{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:core && node scripts/build.mjs all",
    "build:chrome": "pnpm run build:core && node scripts/build.mjs chrome",
    "build:core": "pnpm --filter core build",
    "build:firefox": "pnpm run build:core && node scripts/build.mjs firefox",
    "dev": "vite --host",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openfeature/flagsmith-client-provider": "^0.2.0",
    "@openfeature/react-sdk": "^1.4.1",
    "@openfeature/web-sdk": "^1.10.0",
    "core": "workspace:*",
    "flagsmith": "^9.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.5",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.7",
    "vite": "^8.3.1"
  }
}
